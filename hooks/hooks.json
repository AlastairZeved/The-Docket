{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "DOCKET_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" node \"${CLAUDE_PLUGIN_ROOT}/bin/docket.js\" near",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "DOCKET_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" node \"${CLAUDE_PLUGIN_ROOT}/bin/docket.js\" status --session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/docket.js\" stop --permission \"Bash(node *docket.js*)\" --judge \"claude -p --no-session-persistence --settings '{\\\"disableAllHooks\\\":true}' --allowedTools 'Bash(node *docket.js*)' --disallowedTools 'Write Edit NotebookEdit' --max-turns 60\"",
            "timeout": 630
          }
        ]
      }
    ]
  }
}
